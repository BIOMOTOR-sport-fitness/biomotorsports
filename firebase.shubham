# BIOMOTOR Sport and Fitness — Shubham settings file
# Lines starting with # are notes. tools/shubham-build.js reads this file while building.
# Website on Google Cloud (Firebase Hosting): which files go online and their headers.
{
  "hosting": {
    "public": ".",
    "ignore": [
      "*.shubham",
      "**/.*",
      "**/node_modules/**",
      "apps/**",
      "tools/**",
      "supabase/**",
      "website/**",
      "README.md",
      "netlify.toml",
      "Dockerfile",
      "nginx.conf",
      "cloudbuild.yaml"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/sk/config.sk",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          }
        ]
      },
      {
        "source": "/assets/mediapipe/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(mjs|wasm)",
        "headers": [
          {
            "key": "Cross-Origin-Resource-Policy",
            "value": "same-origin"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|png|jpg|svg)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ]
  }
}
